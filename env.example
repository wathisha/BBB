# ==============================================================================
# Independent Collective School (ICS) ERP - TiDB Cloud Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Engine Selection ('mysql' for TiDB Cloud / MySQL, 'json' for Local JSON fallback)
DB_TYPE=mysql

# ------------------------------------------------------------------------------
# TiDB Cloud Serverless Connection Parameters
# (From TiDB Cloud Console -> Clusters -> Connect)
# ------------------------------------------------------------------------------
# Host: e.g., gateway01.us-east-1.prod.aws.tidbcloud.com or gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com

# Port: TiDB Cloud uses port 4000
DB_PORT=4000

# User: TiDB Cloud format is `<prefix>.root` (e.g., 2AbCdEfGhIj.root)
DB_USER=your_cluster_prefix.root

# Password: Set when creating the cluster or reset in TiDB Cloud Security settings
DB_PASSWORD=your_tidb_password

# Database Name: Default is 'test' or create 'ics_school_db'
DB_NAME=ics_school_db

# SSL/TLS Security: MUST be true for TiDB Cloud Serverless
DB_SSL=true

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true

# Alternative: Direct Connection URI String (If copied directly from TiDB Cloud Console)
# MYSQL_URI=mysql://your_prefix.root:your_password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/ics_school_db?ssl={"minVersion":"TLSv1.2"}

# Administrator Security & JWT Secret
JWT_SECRET=ics_school_super_secure_key_2026
