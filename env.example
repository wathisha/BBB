# ==============================================================================
# Independent Collective School (ICS) ERP - TiDB Cloud Environment Configuration
# Cluster: ics-school-cluster (TiDB Cloud Serverless)
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Engine Selection ('mysql' for TiDB Cloud Serverless, 'json' for Local JSON fallback)
DB_TYPE=mysql

# ------------------------------------------------------------------------------
# TiDB Cloud Serverless Connection Parameters
# Cluster: ics-school-cluster (AWS ap-southeast-1 / Singapore)
# ------------------------------------------------------------------------------
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=m8EeagfP55RQX8G.root
DB_PASSWORD=JYKjieTG8iLqUJve
DB_NAME=ics_school_db

# SSL/TLS Security: Required by TiDB Cloud for public endpoint
DB_SSL=true
# Set to 'false' to allow TLS handshake without local CA file, or provide CA_PATH below
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: Path to custom CA cert (if downloaded from TiDB Cloud Console)
# CA_PATH=./isrgrootx1.pem

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true

# ------------------------------------------------------------------------------
# Alternative: Direct Connection URI String for TiDB Cloud
# ------------------------------------------------------------------------------
MYSQL_URI=mysql://m8EeagfP55RQX8G.root:JYKjieTG8iLqUJve@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/ics_school_db?ssl={"minVersion":"TLSv1.2","rejectUnauthorized":false}

# Administrator Security & JWT Secret
JWT_SECRET=ics_school_cluster_jwt_secret_2026
